# Configuration for the loop stream. bootstrap.sh copies this to stream.env and
# replaces __ROOT__ with the install directory; if you copy it by hand, replace
# __ROOT__ yourself.
#
# This file is read both by systemd (EnvironmentFile) and by the scripts, so it
# has to satisfy the stricter of the two: KEY=value only. No `export`, no shell
# expansion, no quotes unless you mean them literally, no comments after a value.
#
# It holds a secret. Keep it chmod 600 and never commit it.

# From YouTube Studio: Go Live -> Stream -> Stream key. Set it with
# `streamctl key` rather than editing here, so it stays out of your history.
STREAM_KEY=

# YouTube's RTMPS ingest on port 443. If your network blocks it, the plain RTMP
# ingest is rtmp://a.rtmp.youtube.com/live2 on port 1935.
INGEST_URL=rtmps://a.rtmps.youtube.com:443/live2

# The file that plays on a loop. Build it with `streamctl video SOURCE`.
VIDEO=__ROOT__/media/loop.mp4

# copy   — send the file's existing streams untouched. Near-zero CPU. Requires
#          a file prepared by `streamctl video`. This is what you want.
# encode — re-encode live. Costs real CPU and is a tight fit at 1080p on a
#          2-OCPU instance, but it is the one setting that keeps CPU high
#          enough to matter for Oracle's idle-reclamation check. See README.
MODE=copy

# Used by `streamctl video` always, and by the stream itself only in encode
# mode. 4500k/1080p30 sits in YouTube's recommended range.
VIDEO_BITRATE_K=4500
AUDIO_BITRATE_K=128
WIDTH=1920
HEIGHT=1080
FPS=30

# Restart pacing. A run shorter than MIN_RUN_SECONDS is treated as a failure to
# back off from, rather than a blip to retry immediately.
MIN_RUN_SECONDS=60
MAX_BACKOFF_SECONDS=300
