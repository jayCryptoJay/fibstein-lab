+#!/usr/bin/env node
+// Start Chrome with remote debugging (CDP) for the MCP server to attach to.
+// Chrome 136+ ignores --remote-debugging-port on the default user data dir,
+// so this uses a dedicated dir (chrome-profile-kiara/) seeded once from the
+// profile named in config/flow.config.json. Log in there once; it persists.
+import fs from 'fs';
+import path from 'path';
+import { spawn } from 'child_process';
+import { fileURLToPath } from 'url';
+import { get } from '../src/utils/config.js';
+import { resolveChromePath, resolveProfileSource } from '../src/utils/chrome.js';
+
+const PROJECT_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const CDP_PORT = get('cdpPort', 9222);
+const CDP_URL = `http://127.0.0.1:${CDP_PORT}/json/version`;
+const DEBUG_DIR = path.join(PROJECT_DIR, 'chrome-profile-kiara');
+const SKIP = new Set(['Cache', 'Code Cache', 'GPUCache', 'DawnCache', 'GrShaderCache', 'ShaderCache', 'CacheStorage', 'ScriptCache', 'Service Worker']);
+
+const log = (m) => console.error(`[${new Date().toISOString()}] INFO  ${m}`);
+const die = (m) => { console.error(`[${new Date().toISOString()}] ERROR ${m}`); process.exit(1); };
+
+async function cdpUp() {
+  try { return (await fetch(CDP_URL)).ok; } catch { return false; }
+}
+
+function seedProfile(source, profileName) {
+  const target = path.join(DEBUG_DIR, profileName);
+  if (fs.existsSync(target)) return;
+  fs.mkdirSync(DEBUG_DIR, { recursive: true });
+  if (!fs.existsSync(source)) {
+    log(`Source profile ${source} not found — starting with an empty profile (log in once in the window).`);
+    return;
+  }
+  log(`Seeding ${target} from ${source} (first run only)`);
+  let skipped = 0;
+  fs.cpSync(source, target, {
+    recursive: true,
+    filter: (src) => {
+      if (SKIP.has(path.basename(src))) return false;
+      try { fs.accessSync(src, fs.constants.R_OK); return true; } catch { skipped++; return false; }
+    },
+  });
+  const localState = path.join(path.dirname(source), 'Local State');
+  if (fs.existsSync(localState)) fs.copyFileSync(localState, path.join(DEBUG_DIR, 'Local State'));
+  if (skipped) log(`Skipped ${skipped} unreadable/locked files`);
+}
+
+if (await cdpUp()) {
+  log(`Chrome already running with CDP on port ${CDP_PORT}`);
+  process.exit(0);
+}
+
+const chromePath = resolveChromePath();
+if (!fs.existsSync(chromePath)) die(`Chrome not found at ${chromePath} — set "chromePath" in config/flow.config.json`);
+
+const profileSource = resolveProfileSource();
+const profileName = path.basename(profileSource);
+seedProfile(profileSource, profileName);
+
+const args = [
+  `--remote-debugging-port=${CDP_PORT}`,
+  `--user-data-dir=${DEBUG_DIR}`,
+  `--profile-directory=${profileName}`,
+  '--no-first-run',
+  '--no-default-browser-check',
+  '--disable-blink-features=AutomationControlled',
+  '--window-size=1920,1080',
+];
+if (get('headless', false)) args.push('--headless=new');
+args.push(get('flowUrl', 'https://labs.google/fx/tools/flow'));
+
+log(`Launching ${chromePath} (profile "${profileName}", CDP port ${CDP_PORT}, headless=${get('headless', false)})`);
+const child = spawn(chromePath, args, { detached: true, stdio: 'ignore' });
+child.on('error', (e) => die(`Failed to launch Chrome: ${e.message}`));
+child.unref();
+
+for (let i = 0; i < 20; i++) {
+  if (await cdpUp()) {
+    log(`Chrome CDP ready on port ${CDP_PORT} (PID ${child.pid})`);
+    process.exit(0);
+  }
+  await new Promise(r => setTimeout(r, 1000));
+}
+die(`Chrome did not open CDP on port ${CDP_PORT} within 20 seconds`);
