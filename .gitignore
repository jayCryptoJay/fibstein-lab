.venv/
frontend/node_modules/
workspace/
__pycache__/
.pytest_cache/
*.pyc

# Candle and funding caches are regenerated on demand from the public archive
# with checksum verification. ~200MB across 2000+ files — never commit them.
data/
!data/.gitkeep

# The stream key is a live broadcast credential; media and logs are large and
# machine-local. The runtime install lives in ~/loopstream on the server, but
# guard the in-repo paths in case someone points LOOPSTREAM_ROOT at a checkout.
stream/stream.env
stream/media/
stream/logs/
